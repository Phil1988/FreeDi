[Unit]
Description=Starting the FreeDi service
After=moonraker.service klipper.service

[Service]
Type=simple
#User={{USER}}
WorkingDirectory=/home/{{USER}}/FreeDi/FreeDiLCD
# wait for Moonraker, keep pyserial >= 3.5 and wait (bounded) for Klipper to be ready
ExecStartPre=/home/{{USER}}/FreeDi/helpers/freedi_prestart.sh
TimeoutStartSec=300
ExecStart=/bin/sh -c '/home/{{USER}}/klippy-env/bin/python3 /home/{{USER}}/FreeDi/FreeDiLCD/start.py'
Restart=always
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
